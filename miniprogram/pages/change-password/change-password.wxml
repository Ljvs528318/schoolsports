<!--pages/change-password/change-password.wxml-->
<view class="container">
  <view class="header">
    <text class="title">修改密码</text>
  </view>

  <view class="form card">
    <view class="form-item">
      <text class="label">当前密码</text>
      <input class="input" type="password" placeholder="请输入当前密码" bindinput="onInputChange" data-field="old_password" />
    </view>

    <view class="form-item">
      <text class="label">新密码</text>
      <input class="input" type="password" placeholder="请输入新密码（至少6位）" bindinput="onInputChange" data-field="new_password" />
    </view>

    <view class="form-item">
      <text class="label">确认新密码</text>
      <input class="input" type="password" placeholder="请再次输入新密码" bindinput="onInputChange" data-field="confirm_password" />
    </view>
  </view>

  <view class="btn-section">
    <button class="btn-primary" bindtap="changePassword" loading="{{saving}}">确认修改</button>
    <button class="btn-cancel" bindtap="goBack">取消</button>
  </view>
</view>
