/* pages/admin-draw/admin-draw.wxss */
.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.section {
  background: white;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #333;
}

.picker {
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  color: #666;
}

.info-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
}

.info-title {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 12rpx;
}

.info-desc {
  font-size: 26rpx;
  opacity: 0.9;
  display: block;
  margin-bottom: 16rpx;
}

.info-detail {
  font-size: 24rpx;
  opacity: 0.8;
}

.btn-draw {
  background: #1890ff;
  color: white;
  font-size: 32rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
}

.btn-draw[disabled] {
  background: #ccc;
}

.match-item {
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: white;
  border-radius: 12rpx;
}

.match-num {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 12rpx;
}

.match-teams {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.team {
  font-size: 30rpx;
  font-weight: 500;
}

.vs {
  font-size: 28rpx;
  color: #999;
}

.empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
}
