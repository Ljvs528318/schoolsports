/* pages/register/register.wxss */
.container {
  padding: 30rpx;
}

.header {
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
}

/* 赛事信息 */
.competition-info {
  margin-bottom: 30rpx;
}

.comp-name {
  font-size: 32rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}

.comp-meta {
  display: flex;
  gap: 12rpx;
}

/* 个人赛确认区域 */
.confirm-section {
  margin-bottom: 30rpx;
  text-align: center;
}

.confirm-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.confirm-title {
  font-size: 34rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
  color: #333;
}

.confirm-desc {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 24rpx;
}

.confirm-info {
  text-align: left;
  margin-top: 24rpx;
}

.info-row {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-label {
  font-size: 28rpx;
  color: #999;
  width: 120rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: #333;
}

/* 表单通用 */
.form-section {
  margin-bottom: 30rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.label {
  font-size: 28rpx;
  color: #333;
  width: 160rpx;
  flex-shrink: 0;
}

.required {
  color: #ff4d4f;
  margin-left: 4rpx;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* 队长信息 */
.captain-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

/* 队员信息 */
.members-section {
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.member-count {
  font-size: 24rpx;
  color: #999;
}

.member-card {
  margin-bottom: 20rpx;
  position: relative;
}

.member-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.member-index {
  font-size: 28rpx;
  font-weight: bold;
  color: #1890ff;
}

.remove-btn {
  font-size: 24rpx;
  color: #ff4d4f;
  padding: 8rpx 16rpx;
}

/* 按钮 */
.btn-add {
  margin-top: 20rpx;
  background: #f5f5f5;
  color: #1890ff;
  font-size: 28rpx;
  border: 1rpx dashed #1890ff;
}

.submit-btn {
  margin-top: 40rpx;
}

/* 提示 */
.tips {
  margin-top: 30rpx;
}

.tips-text {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}
