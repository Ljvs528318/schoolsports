<!--pages/edit-profile/edit-profile.wxml-->
<view class="container">
  <view class="header">
    <text class="title">编辑个人资料</text>
  </view>

  <view class="form card">
    <view class="form-item">
      <text class="label">用户名</text>
      <input class="input" value="{{form.username}}" disabled placeholder="用户名不可修改" />
    </view>

    <view class="form-item">
      <text class="label">真实姓名</text>
      <input class="input" value="{{form.real_name}}" placeholder="请输入真实姓名" bindinput="onInputChange" data-field="real_name" />
    </view>

    <view class="form-item">
      <text class="label">学号</text>
      <input class="input" value="{{form.student_id}}" placeholder="请输入学号" bindinput="onInputChange" data-field="student_id" />
    </view>

    <view class="form-item">
      <text class="label">班级</text>
      <input class="input" value="{{form.class_name}}" placeholder="请输入班级" bindinput="onInputChange" data-field="class_name" />
    </view>

    <view class="form-item">
      <text class="label">邮箱</text>
      <input class="input" value="{{form.email}}" placeholder="请输入邮箱" bindinput="onInputChange" data-field="email" />
    </view>

    <view class="form-item">
      <text class="label">手机号</text>
      <input class="input" value="{{form.phone}}" placeholder="请输入手机号" bindinput="onInputChange" data-field="phone" />
    </view>
  </view>

  <view class="btn-section">
    <button class="btn-primary" bindtap="saveProfile" loading="{{saving}}">保存修改</button>
    <button class="btn-cancel" bindtap="goBack">取消</button>
  </view>
</view>
