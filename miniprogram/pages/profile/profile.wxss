/* pages/profile/profile.wxss */
.user-section {
  display: flex;
  align-items: center;
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #1890ff;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: bold;
  margin-right: 30rpx;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
}

.name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.role {
  font-size: 26rpx;
  display: inline-block;
  margin-bottom: 4rpx;
  padding: 2rpx 16rpx;
  border-radius: 20rpx;
  color: #999;
  background: #f0f0f0;
}

.role-admin {
  color: #1890ff;
  background: #e6f7ff;
}

.info-detail {
  font-size: 24rpx;
  color: #bbb;
  display: block;
  margin-top: 4rpx;
}

.login-prompt {
  text-align: center;
  padding: 100rpx 40rpx;
}

.prompt-text {
  display: block;
  font-size: 32rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.menu-section {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 36rpx;
  color: #999;
}

.logout-section {
  padding: 0 20rpx;
}

.btn-logout {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #fff;
  color: #ff4d4f;
  border: 2rpx solid #ff4d4f;
  border-radius: 8rpx;
  font-size: 32rpx;
}

.registrations-section {
  margin-top: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
  border-left: 8rpx solid #1890ff;
}

.reg-item {
  margin-bottom: 16rpx;
}

.reg-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.comp-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.reg-team {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 4rpx;
}

.reg-time {
  font-size: 24rpx;
  color: #999;
}
