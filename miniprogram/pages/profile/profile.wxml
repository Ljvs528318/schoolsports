<!--pages/profile/profile.wxml-->
<view class="container">
  <view class="user-section card" wx:if="{{userInfo}}">
    <view class="avatar">{{userInfo.real_name ? userInfo.real_name[0] : 'U'}}</view>
    <view class="user-info">
      <text class="name">{{userInfo.real_name || userInfo.username}}</text>
      <text class="role {{userInfo.role === 'admin' ? 'role-admin' : ''}}">{{userInfo.role === 'admin' ? '管理员' : (userInfo.role === 'teacher' ? '教师' : '学生')}}</text>
      <text class="info-detail" wx:if="{{userInfo.student_id}}">学号: {{userInfo.student_id}}</text>
      <text class="info-detail" wx:if="{{userInfo.class_name}}">班级: {{userInfo.class_name}}</text>
    </view>
  </view>

  <view class="login-prompt" wx:if="{{!userInfo}}">
    <text class="prompt-text">请先登录</text>
    <button class="btn-primary" bindtap="goToLogin">立即登录</button>
  </view>

  <view class="menu-section" wx:if="{{userInfo}}">
    <!-- 管理员菜单 -->
    <block wx:if="{{userInfo.role === 'admin'}}">
      <view class="menu-item" bindtap="goToAdmin">
        <text class="menu-icon">⚙️</text>
        <text class="menu-text">管理后台</text>
        <text class="menu-arrow">›</text>
      </view>
    </block>

    <!-- 普通用户菜单 -->
    <block wx:else>
      <view class="menu-item" bindtap="viewMyRegistrations">
        <text class="menu-icon">📝</text>
        <text class="menu-text">我的报名</text>
        <text class="menu-arrow">›</text>
      </view>
    </block>

    <view class="menu-item" bindtap="viewProfile">
      <text class="menu-icon">👤</text>
      <text class="menu-text">个人资料</text>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="changePassword">
      <text class="menu-icon">🔒</text>
      <text class="menu-text">修改密码</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="logout-section" wx:if="{{userInfo}}">
    <button class="btn-logout" bindtap="handleLogout">退出登录</button>
  </view>

  <!-- 我的报名列表 -->
  <view class="registrations-section" wx:if="{{showRegistrations}}">
    <view class="section-title">我的报名</view>
    <view class="reg-item card" wx:for="{{registrations}}" wx:key="id">
      <view class="reg-header">
        <text class="comp-name">{{item.competition_name}}</text>
        <text class="tag tag-{{item.status === 'approved' ? 'success' : (item.status === 'pending' ? 'warning' : 'danger')}}">
          {{item.status === 'approved' ? '已通过' : (item.status === 'pending' ? '待审核' : '已拒绝')}}
        </text>
      </view>
      <text class="reg-team" wx:if="{{item.team_name}}">队伍: {{item.team_name}}</text>
      <text class="reg-time" wx:if="{{item.created_at}}">报名: {{item.created_at}}</text>
    </view>

    <view class="empty" wx:if="{{registrations.length === 0}}">
      <text class="empty-text">暂无报名记录</text>
    </view>
  </view>
</view>
