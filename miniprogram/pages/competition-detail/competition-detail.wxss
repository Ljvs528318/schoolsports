/* pages/competition-detail/competition-detail.wxss */
.detail-card {
  margin-bottom: 30rpx;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 16rpx;
}

.detail-info {
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  margin-bottom: 12rpx;
  font-size: 28rpx;
}

.info-row .label {
  color: #999;
  width: 160rpx;
}

.info-row .value {
  color: #666;
  flex: 1;
}

.detail-desc {
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
}

.desc-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.desc-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.detail-time {
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.time-row {
  display: flex;
  margin-bottom: 8rpx;
  font-size: 26rpx;
}

.time-row .label {
  color: #999;
  width: 160rpx;
}

.time-row .value {
  color: #666;
}

/* 最终结果样式 */
.final-result {
  margin-bottom: 30rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #fffbe6, #fff7e6);
  border: 2rpx solid #ffe58f;
}

.final-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fa8c16;
  text-align: center;
  margin-bottom: 24rpx;
}

.champion-section {
  text-align: center;
}

.champion-row {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: linear-gradient(135deg, #ffd700, #ffec3d);
  border-radius: 12rpx;
}

.runner-up-row {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  background: #f0f0f0;
  border-radius: 12rpx;
}

.medal {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.champion-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #8b6914;
}

.champion-score {
  font-size: 30rpx;
  color: #ad6800;
  margin-left: 20rpx;
}

.runner-up-name {
  font-size: 30rpx;
  color: #666;
}

/* 循环赛排名样式 */
.league-results {
  margin-top: 20rpx;
}

.league-group {
  margin-bottom: 20rpx;
}

.group-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.rank-row {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  margin-bottom: 8rpx;
  background: #fff;
  border-radius: 8rpx;
}

.rank-name {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

.rank-points {
  font-size: 28rpx;
  color: #fa8c16;
  font-weight: bold;
}

.actions {
  margin-bottom: 30rpx;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 8rpx;
  font-size: 32rpx;
  margin-bottom: 20rpx;
}

.btn-secondary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #fff;
  color: #1890ff;
  border: 2rpx solid #1890ff;
  border-radius: 8rpx;
  font-size: 32rpx;
  margin-bottom: 20rpx;
}

.reg-status {
  text-align: center;
  padding: 16rpx;
  background: #f6ffed;
  border-radius: 8rpx;
}

.status-text {
  color: #52c41a;
  font-size: 28rpx;
}

.quick-actions {
  display: flex;
  gap: 20rpx;
}

.quick-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
  font-size: 28rpx;
}
