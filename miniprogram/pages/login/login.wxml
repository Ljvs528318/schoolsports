<!--pages/login/login.wxml-->
<view class="container">
  <view class="logo-section">
    <view class="logo">🏫</view>
    <text class="title">校园体育管理系统</text>
    <text class="subtitle">微信小程序版</text>
  </view>

  <view class="form-section">
    <!-- 登录表单 -->
    <view class="form" wx:if="{{!showRegisterForm}}">
      <view class="form-item">
        <text class="label">用户名</text>
        <input class="input" placeholder="请输入用户名" value="{{username}}" bindinput="onUsernameInput"/>
      </view>

      <view class="form-item">
        <text class="label">密码</text>
        <input class="input" placeholder="请输入密码" password="{{true}}" value="{{password}}" bindinput="onPasswordInput"/>
      </view>

      <button class="btn-primary login-btn" bindtap="handleLogin" loading="{{loading}}">
        登录
      </button>

      <view class="form-footer">
        <text class="link" bindtap="toggleRegisterForm">没有账号？立即注册</text>
      </view>
    </view>

    <!-- 注册表单 -->
    <view class="form" wx:if="{{showRegisterForm}}">
      <view class="form-item">
        <text class="label">用户名<text class="required">*</text></text>
        <input class="input" placeholder="请输入用户名" value="{{regUsername}}" bindinput="onRegUsernameInput"/>
      </view>

      <view class="form-item">
        <text class="label">密码<text class="required">*</text></text>
        <input class="input" placeholder="至少6位" password="{{true}}" value="{{regPassword}}" bindinput="onRegPasswordInput"/>
      </view>

      <view class="form-item">
        <text class="label">确认密码<text class="required">*</text></text>
        <input class="input" placeholder="再次输入密码" password="{{true}}" value="{{regConfirmPassword}}" bindinput="onRegConfirmPasswordInput"/>
      </view>

      <view class="form-item">
        <text class="label">真实姓名</text>
        <input class="input" placeholder="请输入真实姓名" value="{{regRealName}}" bindinput="onRegRealNameInput"/>
      </view>

      <view class="form-item">
        <text class="label">学号/工号</text>
        <input class="input" placeholder="请输入学号或工号" value="{{regStudentId}}" bindinput="onRegStudentIdInput"/>
      </view>

      <view class="form-item">
        <text class="label">班级/部门</text>
        <input class="input" placeholder="请输入班级或部门" value="{{regClassName}}" bindinput="onRegClassNameInput"/>
      </view>

      <button class="btn-primary register-btn" bindtap="handleRegister" loading="{{regLoading}}">
        注册
      </button>

      <view class="form-footer">
        <text class="link" bindtap="toggleRegisterForm">已有账号？立即登录</text>
      </view>
    </view>
  </view>
</view>
