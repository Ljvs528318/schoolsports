/* pages/standings/standings.wxss */
.header {
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
}

.group-section {
  margin-bottom: 40rpx;
}

.group-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1890ff;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #1890ff;
}

.standings-table {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

.table-header {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
  font-size: 24rpx;
  color: #999;
  font-weight: bold;
}

.table-row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 26rpx;
  align-items: center;
}

.table-row.top-3 {
  background: #fafafa;
}

.col-rank {
  width: 60rpx;
  text-align: center;
  font-weight: bold;
}

.col-rank.rank-1 {
  color: #ff4d4f;
}

.col-rank.rank-2 {
  color: #fa8c16;
}

.col-rank.rank-3 {
  color: #faad14;
}

.col-team {
  flex: 1;
  padding: 0 12rpx;
}

.col-played, .col-win, .col-draw, .col-loss, .col-points {
  width: 60rpx;
  text-align: center;
}

.col-points {
  font-weight: bold;
  color: #1890ff;
}
